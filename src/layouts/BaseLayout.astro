---
/**
 * BaseLayout — the document shell every page uses.
 * Owns <html>, <head>, header, footer, and the small global scripts.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/prose.css";
import "../styles/utilities.css";
import "../styles/refinement.css";
import "../styles/editorial.css";
import "../styles/human.css";
import "../styles/playground.css";
import { ClientRouter } from "astro:transitions";
import SearchDialog from "../components/SearchDialog.astro";

// Fonts are self-hosted through Fontsource: no third-party requests, and
// an automatic preload/fallback for the fonts actually used above the fold.
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  lang?: string;
  locale?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  tags?: string[];
  /** Adds a wide-content modifier for index pages. */
  wide?: boolean;
  /** Hide the footer (used by 404 and print views). */
  bare?: boolean;
}

const props = Astro.props;
const path = props.path ?? Astro.url.pathname;
---

<!doctype html>
<html lang={props.lang ?? site.language} data-theme="dark">
  <head>
    <Seo {...props} path={path} />
    <ClientRouter fallback="swap" />
    <ThemeScript />
  </head>
  <body id="top">
    <a lang="en" class="skip-link" href="#main">Skip to content</a>
    <Header />
    <SearchDialog />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!props.bare && <Footer />}

    <script>
      import "../lib/site";
    </script>
    <script>
      import "../lib/motion";
    </script>
  </body>
</html>
