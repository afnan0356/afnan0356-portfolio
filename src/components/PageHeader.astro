---
/**
 * PageHeader — the standard opening for every interior page.
 * An eyebrow label, a large display title, a short lede, and an
 * optional meta row or action slot underneath.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Optional small counter, e.g. "7 projects". */
  meta?: string;
  align?: "start" | "center";
  quiet?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  meta,
  align = "start",
  quiet = false,
} = Astro.props;
---

<header
  class:list={[
    "page-header",
    align === "center" && "page-header--center",
    quiet && "page-header--quiet",
  ]}
  data-hero
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-header__title" data-title-line>{title}</h1>
  {
    lede && (
      <p class="page-header__lede" data-enter>
        {lede}
      </p>
    )
  }
  {meta && <p class="page-header__meta mono">{meta}</p>}
  <slot />
</header>

<style>
  .page-header {
    display: grid;
    gap: 1.2rem;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 2.5rem;
    max-width: 58rem;
  }

  .page-header--quiet .page-header__title {
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .page-header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
    max-width: 52ch;
  }

  .page-header__title {
    font-size: clamp(2.75rem, 5.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .page-header__lede {
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.75;
    max-width: 52ch;
  }

  .page-header__meta {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .page-header :global(.page-header__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: var(--space-2xs);
  }
</style>
