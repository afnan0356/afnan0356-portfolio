---
/**
 * Seo — every page's <head> metadata in one place.
 * Titles, descriptions, canonical URLs, Open Graph, Twitter cards,
 * and JSON-LD structured data.
 */
import { site } from "../config/site";

interface Props {
  title: string;
  lang?: string;
  locale?: string;
  description?: string;
  /** Path of the page, e.g. "/blog/" — used for canonical + og:url. */
  path: string;
  image?: string;
  type?: "website" | "article" | "profile";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  /** Extra keywords for very specific pages (optional, low priority). */
  tags?: string[];
}

const {
  title,
  description = site.description,
  path,
  image = site.ogImage,
  type = "website",
  published,
  updated,
  noindex = false,
  tags,
  lang = site.language,
  locale = site.locale,
} = Astro.props;

// Canonical URLs need a real domain. Until SITE_URL is configured we
// emit only relative-friendly metadata and skip canonical/og:url so we
// never publish a wrong URL.
const base = Astro.site;
const canonical = base ? new URL(path, base).href : null;
const imageUrl = image.startsWith("http")
  ? image
  : base
    ? new URL(image, base).href
    : image;

const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebSite",
  name: site.name,
  ...(canonical ? { url: canonical } : {}),
  description,
  inLanguage: lang,
  ...(type === "article" && published
    ? { datePublished: published.toISOString() }
    : {}),
  ...(type === "article" && updated
    ? { dateModified: updated.toISOString() }
    : {}),
  ...(tags?.length ? { keywords: tags.join(", ") } : {}),
  author: {
    "@type": "Person",
    name: site.name,
    url: "https://github.com/afnan0356",
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{tags?.length && <meta name="keywords" content={tags.join(", ")} />}
<meta name="author" content={site.name} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )
}

{canonical && <link rel="canonical" href={canonical} />}

<!-- Theme colour: one tag, kept in sync with the active theme by the inline script. -->
<meta name="theme-color" content={site.themeColor.dark} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale} />
{canonical && <meta property="og:url" content={canonical} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{
  imageUrl && (
    <meta property="og:image:alt" content={`${site.name} — ${title}`} />
  )
}
{
  type === "article" && published && (
    <meta property="article:published_time" content={published.toISOString()} />
  )
}
{
  type === "article" && updated && (
    <meta property="article:modified_time" content={updated.toISOString()} />
  )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<!-- Icons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Feeds (only emitted when a site URL is configured) -->
{
  base && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href="/rss.xml"
    />
  )
}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
