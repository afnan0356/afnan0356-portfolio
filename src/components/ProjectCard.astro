---
/**
 * ProjectCard — used on the homepage and the projects index.
 * Renders a real cover image when the project has one, and falls back to
 * a typographic plate so the layout never looks broken or half-finished.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { statusLabels } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Large variant for the homepage's featured grid. */
  featured?: boolean;
  /** Serial number shown in the corner, e.g. "01". */
  index?: number;
}

const { project, featured = false, index } = Astro.props;
const { title, summary, year, status, stack, cover, coverAlt, demo, caseStudy } = project.data;
const href = `/projects/${project.id}/`;
const isLive = status === 'live' || status === 'completed';
---

<article class:list={['card', featured && 'card--featured']}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 720, 1080]}
          sizes={featured ? '(min-width: 64rem) 42rem, 92vw' : '(min-width: 64rem) 26rem, 92vw'}
          loading="lazy"
          decoding="async"
          class="card__image"
        />
      ) : (
        <span class="card__plate">
          <span class="card__plate-mark">{title.slice(0, 1)}</span>
          <span class="card__plate-lines" aria-hidden="true"></span>
        </span>
      )
    }
    {index !== undefined && <span class="card__index mono">{String(index).padStart(2, '0')}</span>}
  </a>

  <div class="card__body">
    <div class="card__meta">
      <span class:list={['status', isLive ? 'status--live' : 'status--in-progress']}>
        {statusLabels[status]}
      </span>
      <span class="mono">{year}</span>
      {demo && <span class="chip">Sample</span>}
    </div>

    <h3 class="card__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="card__summary">{summary}</p>

    {
      stack.length > 0 && (
        <ul class="card__stack" aria-label="Technologies">
          {stack.slice(0, featured ? 5 : 4).map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    <div class="card__foot">
      <a class="card__more" href={href}>
        {caseStudy ? 'Read the case study' : 'View project'}
        <Icon name="arrow-right" size={14} />
      </a>
      {
        project.data.links.repo && (
          <a class="card__ext" href={project.data.links.repo} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={15} />
            <span class="sr-only">Source code for {title}</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color var(--dur-mid) var(--ease-out),
      translate var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }

  .card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      translate: 0 -2px;
    }
  }

  /* The whole card is not a link (nested links are invalid), but the
     media area and the title both point at the project. */
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-sunken);
    border-block-end: 1px solid var(--line);
    overflow: hidden;
  }

  .card__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
    transition: scale var(--dur-slow) var(--ease-out);
  }

  .card:hover .card__image {
    scale: 1.025;
  }

  /* Typographic fallback plate — deliberately designed, not an error state. */
  .card__plate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      linear-gradient(140deg, var(--accent-soft), transparent 60%),
      repeating-linear-gradient(
        135deg,
        transparent,
        transparent 11px,
        var(--grid-line) 11px,
        var(--grid-line) 12px
      );
  }

  .card__plate-mark {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    color: var(--ink);
    opacity: 0.14;
    user-select: none;
  }

  .card__index {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.85rem;
    font-size: 0.6875rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: var(--space-md);
    flex: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    color: var(--ink-faint);
    letter-spacing: 0.03em;
  }

  .card__title {
    font-size: var(--text-lg);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .card__title a {
    text-decoration: none;
    color: var(--ink);
  }

  /* A wider, more forgiving hit area for the title on touch screens. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .card:hover .card__title a {
    color: var(--accent);
  }

  .card__summary {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 46ch;
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin-block-start: auto;
    padding-block-start: 0.35rem;
  }

  .card__stack li {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    padding: 0.16rem 0.4rem;
    white-space: nowrap;
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block-start: 0.35rem;
    position: relative;
    z-index: 1;
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    pointer-events: none; /* the card-wide link handles the click */
  }

  .card__more svg {
    transition: translate var(--dur-fast) var(--ease-out);
  }

  .card:hover .card__more {
    color: var(--accent);
  }

  .card:hover .card__more svg {
    translate: 2px 0;
  }

  .card__ext {
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    margin: -0.35rem -0.35rem -0.35rem 0;
    border-radius: var(--radius-sm);
    color: var(--ink-faint);
  }

  .card__ext:hover {
    color: var(--ink);
    background: var(--bg-hover);
  }

  .card--featured .card__title {
    font-size: var(--text-xl);
  }

  @media (min-width: 64rem) {
    .card--featured {
      flex-direction: row;
    }

    .card--featured .card__media {
      inline-size: 52%;
      border-block-end: 0;
      border-inline-end: 1px solid var(--line);
    }

    .card--featured .card__body {
      padding: var(--space-lg);
      justify-content: center;
    }
  }
</style>
