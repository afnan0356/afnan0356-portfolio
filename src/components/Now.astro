---
import { now } from "../data/now";
---

<section id="now" class="home-now container" aria-labelledby="now-title" data-reveal>
  <div>
    <p class="folio-label">A small check-in</p><h2 id="now-title">
      What I’m up to now.
    </h2>
    <p>{now.month ?? "Monthly note · month to add"}</p>
  </div>
  <dl class="now-grid">
    <div><dt>Building</dt><dd>{now.building}</dd></div>
    <div>
      <dt>Reading</dt><dd>
        {
          now.reading ??
            "Reading placeholder — I’ll add what I’m actually reading in the next update."
        }
      </dd>
    </div>
    <div><dt>Learning</dt><dd>{now.learning}</dd></div>
  </dl>
</section>
