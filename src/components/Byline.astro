---
/**
 * Byline — date, reading time and tags for articles and stories.
 * Dates use <time> with an ISO value so they are machine-readable.
 */
import { formatDate, isoDate } from '../lib/text';
import Icon from './Icon.astro';

interface Props {
  published: Date;
  updated?: Date;
  readingTime?: number;
  /** Optional tag links, shown as chips. */
  tags?: string[];
  tagBase?: string;
}

const { published, updated, readingTime, tags, tagBase } = Astro.props;
---

<div class="byline">
  <span class="byline__item">
    <Icon name="clock" size={13} />
    <time datetime={isoDate(published)}>{formatDate(published)}</time>
  </span>
  {readingTime && <span class="byline__item">{readingTime} min read</span>}
  {updated && isoDate(updated) !== isoDate(published) && (
    <span class="byline__item byline__item--muted">
      Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
    </span>
  )}
  {
    tags && tags.length > 0 && (
      <ul class="byline__tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            {tagBase ? (
              <a class="chip" href={`${tagBase}${tag}/`}>
                {tag}
              </a>
            ) : (
              <span class="chip">{tag}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  .byline__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .byline__item--muted {
    color: var(--ink-faint);
  }

  .byline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }
</style>
