---
/**
 * Footer — navigation, live social links only, and a small colophon.
 * Links with `href: null` in the config are skipped entirely, so there
 * are never decorative icons that lead nowhere.
 */
import { site, socials, isLive, footerNote } from "../config/site";
import Icon from "./Icon.astro";
import LanguageLink from "./LanguageLink.astro";

const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
const footerSocials = [
  ...socials.filter((social) => social.inFooter && isLive(social.href)),
  ...(site.email
    ? [{ label: "Email", href: `mailto:${site.email}`, icon: "mail" as const }]
    : []),
];

// The RSS feed is only generated when a site URL is configured, so the link
// only appears then — never a dead link.
const hasFeed = Boolean(Astro.site);

const columns = [
  {
    title: "Work",
    links: [
      { label: "Projects", href: "/projects/" },
      { label: "Case studies", href: "/projects/#case-studies" },
      { label: "CV", href: "/cv/" },
    ],
  },
  {
    title: "Reading",
    links: [
      { label: "Writing", href: "/writing/" },
      { label: "Blog", href: "/blog/" },
      { label: "Vault", href: "/vault/" },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { label: "About", href: "/about/" },
      { label: "Playground · demos", href: "/playground/" },
      { label: "Contact", href: "/contact/" },
      ...(hasFeed ? [{ label: "RSS feed", href: "/rss.xml" }] : []),
    ],
  },
];
---

<footer class="site-footer" lang="en">
  <div class="container">
    <div class="site-footer__top" data-motion="stagger">
      <div class="site-footer__brand">
        <a class="site-footer__name" href="/">{site.name}</a>
        <p class="site-footer__line">{site.headline}</p>
        {
          footerSocials.length > 0 && (
            <ul class="site-footer__socials" aria-label="Social profiles">
              {footerSocials.map((social) => (
                <li>
                  <a
                    href={social.href!}
                    rel="noopener noreferrer"
                    target={
                      social.href!.startsWith("mailto:") ? undefined : "_blank"
                    }
                  >
                    <Icon name={social.icon} size={17} />
                    <span>{social.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        {
          columns.map((column) => (
            <div class="site-footer__col">
              <h2 class="site-footer__col-title">{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    {
      isHome && (
        <div class="footer-signature" aria-hidden="true">
          {site.shortName}
          <span>↗</span>
        </div>
      )
    }
    <LanguageLink />
    <div class="site-footer__bottom">
      <p>
        © {year}
        {site.name}. <span class="site-footer__note">{footerNote}</span>
      </p>
      <a class="site-footer__top-link" href="#top">
        Back to top
        <Icon name="arrow-right" size={13} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(2rem, 4vw, 3.5rem) 1rem;
    background: var(--bg-raised);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .site-footer__name {
    font: 400 0.75rem/1.5 var(--font-mono);
    color: var(--ink);
    text-decoration: none;
  }
  .site-footer__line {
    font: 400 1.45rem/1.35 var(--font-display);
    color: var(--ink-soft);
    max-width: 30ch;
    margin-top: 0.75rem;
  }
  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    gap: 0 1rem;
    margin-top: 1rem;
  }
  .site-footer__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .site-footer__socials svg {
    width: 14px;
    height: 14px;
  }
  .site-footer__socials a:hover,
  .site-footer__col a:hover {
    color: var(--accent);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .site-footer__col-title {
    font: 400 0.6875rem/1.5 var(--font-mono);
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }
  .site-footer__col ul {
    list-style: none;
    padding: 0;
  }
  .site-footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .footer-signature {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 2rem;
    font: 400 clamp(4rem, 9vw, 8rem) / 1 var(--font-display);
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .footer-signature span {
    font: 400 0.3em/1 var(--font-sans);
    color: var(--accent);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    border-top: 1px solid var(--line);
    margin-top: 1.5rem;
    padding-top: 1rem;
    font: 400 0.6875rem/1.8 var(--font-mono);
    color: var(--ink-muted);
  }
  .site-footer__note {
    display: block;
  }
  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .site-footer__top-link svg {
    rotate: -90deg;
    transition: translate var(--dur-fast) var(--ease-out);
  }
  .site-footer__top-link:hover {
    color: var(--accent);
  }
  .site-footer__top-link:hover svg {
    translate: 0 -3px;
  }
  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
    .site-footer__socials {
      max-width: 31rem;
    }
    .site-footer__note {
      display: inline;
    }
  }
</style>
