---
/**
 * Footer — navigation, live social links only, and a small colophon.
 * Links with `href: null` in the config are skipped entirely, so there
 * are never decorative icons that lead nowhere.
 */
import { site, socials, isLive, footerNote } from '../config/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const footerSocials = socials.filter((social) => social.inFooter && isLive(social.href));

// The RSS feed is only generated when a site URL is configured, so the link
// only appears then — never a dead link.
const hasFeed = Boolean(Astro.site);

const columns = [
  {
    title: 'Work',
    links: [
      { label: 'Projects', href: '/projects/' },
      { label: 'Case studies', href: '/projects/#case-studies' },
      { label: 'CV', href: '/cv/' },
    ],
  },
  {
    title: 'Reading',
    links: [
      { label: 'Writing', href: '/writing/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Vault', href: '/vault/' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      ...(hasFeed ? [{ label: 'RSS feed', href: '/rss.xml' }] : []),
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__name" href="/">{site.name}</a>
        <p class="site-footer__line">{site.headline}</p>
        {
          footerSocials.length > 0 && (
            <ul class="site-footer__socials" aria-label="Social profiles">
              {footerSocials.map((social) => (
                <li>
                  <a href={social.href!} rel="me noopener noreferrer" target="_blank">
                    <Icon name={social.icon} size={17} label={social.label} />
                    <span>{social.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        {
          columns.map((column) => (
            <div class="site-footer__col">
              <h2 class="site-footer__col-title">{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. <span class="site-footer__note">{footerNote}</span></p>
      <a class="site-footer__top-link" href="#top">
        Back to top
        <Icon name="arrow-right" size={13} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-3xl);
    border-block-start: 1px solid var(--line);
    padding-block: var(--space-2xl) var(--space-lg);
    background: linear-gradient(180deg, transparent, var(--bg-sunken));
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-footer__line {
    margin-block-start: 0.4rem;
    max-width: 34ch;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-sm);
  }

  .site-footer__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .site-footer__socials a:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--bg-hover);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-md);
  }

  .site-footer__col-title {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-block-end: 0.75rem;
  }

  .site-footer__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__col a {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .site-footer__note {
    display: block;
    margin-block-start: 0.3rem;
    color: var(--ink-faint);
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .site-footer__top-link svg {
    rotate: -90deg;
    transition: translate var(--dur-fast) var(--ease-out);
  }

  .site-footer__top-link:hover {
    color: var(--accent);
  }

  .site-footer__top-link:hover svg {
    translate: 0 -3px;
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 1.2fr);
      gap: var(--space-2xl);
    }

    .site-footer__note {
      display: inline;
      margin: 0;
    }
  }
</style>
