---
/** Light/dark switch. The control is a real button with a stateful label. */
import Icon from './Icon.astro';

interface Props {
  /** Compact variant used inside the mobile menu. */
  labelled?: boolean;
}
const { labelled = false } = Astro.props;
---

<button
  class:list={['theme-toggle', labelled && 'theme-toggle--labelled']}
  type="button"
  data-theme-toggle
  aria-label="Switch to light theme"
  aria-pressed="false"
  title="Switch theme"
>
  <span class="theme-toggle__icons" aria-hidden="true">
    <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size={17} /></span>
    <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size={17} /></span>
  </span>
  {labelled && <span class="theme-toggle__text" aria-hidden="true">Theme</span>}
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    inline-size: 2.375rem;
    block-size: 2.375rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--bg-hover);
  }

  .theme-toggle--labelled {
    inline-size: auto;
    padding-inline: 0.7rem;
    height: 2.75rem;
    min-block-size: 2.75rem;
  }

  .theme-toggle__text {
    font-size: var(--text-sm);
  }

  .theme-toggle__icons {
    position: relative;
    display: block;
    inline-size: 17px;
    block-size: 17px;
  }

  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-mid) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out),
      scale var(--dur-mid) var(--ease-out);
  }

  /* Dark theme shows the sun (the action is "go light"). */
  :global([data-theme='dark']) .theme-toggle__icon--sun,
  :root:not([data-theme='light']) .theme-toggle__icon--sun {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  :global([data-theme='dark']) .theme-toggle__icon--moon,
  :root:not([data-theme='light']) .theme-toggle__icon--moon {
    opacity: 0;
    rotate: -90deg;
    scale: 0.5;
  }

  :global([data-theme='light']) .theme-toggle__icon--sun {
    opacity: 0;
    rotate: 90deg;
    scale: 0.5;
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }
</style>
