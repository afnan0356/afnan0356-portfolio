---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config/site";
import {
  getFeaturedProjects,
  getPosts,
  getPieces,
  getBooks,
  getVaultItems,
} from "../lib/content";
import { formatMonth, isoDate } from "../lib/text";
import { timeline, timelineStateLabels } from "../data/timeline";
import "../styles/home.css";

const learning = timeline.filter((entry) =>
  [
    "Accessibility as a build step",
    "Typed data modelling for legal content",
    "Longer-form writing",
  ].includes(entry.title),
);
const projects = await getFeaturedProjects(3);
const posts = (await getPosts()).slice(0, 2);
const pieces = await getPieces();
const books = await getBooks();
const writing = [...books, ...pieces].slice(0, 2);
const evidence = (await getVaultItems())
  .filter((item) => item.data.verification === "verified")
  .slice(0, 3);
---

<BaseLayout title={site.title} description={site.description} path="/">
  <section class="home-hero container" aria-labelledby="hero-title" data-hero>
    <div class="hero-topline" data-enter>
      <p class="folio-label">
        Personal projects <span>Open source · 2026</span>
      </p>
      <p class="folio-label hero-discipline">
        Web development &amp; information design
      </p>
    </div>
    <h1 class="hero-heading" id="hero-title">
      <span class="title-mask"><span data-title-line>Md. Afnan.</span></span>
      <span class="title-mask"
        ><em data-title-line>Building for readers.</em></span
      >
    </h1>
    <div class="hero-bottom">
      <div class="hero-intro" data-enter>
        <p>{site.intro}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#selected-work"
            >Explore the work <Icon name="arrow-down" size={16} /></a
          >
          <a class="text-link" href="/about/"
            >A little about me <Icon name="arrow-up-right" size={15} /></a
          >
        </div>
      </div>
      <aside class="hero-current" data-enter aria-label="Current work">
        <div>
          <p class="folio-label">On my desk</p><p>
            Nyayota — legal information, structured for the web.
          </p><a class="text-link" href="/projects/nyayota/"
            >Meet Nyayota <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </aside>
    </div>
    <div class="hero-baseline" data-enter>
      <span class="folio-label"
        >An ongoing practice in code, reading &amp; clarity</span
      ><a href="#selected-work" class="folio-label"
        >Selected work <Icon name="arrow-down" size={14} /></a>
    </div>
  </section>

  <section
    class="home-work container"
    id="selected-work"
    aria-labelledby="work-title"
  >
    <div class="folio-section-head" data-motion="reveal">
      <p class="folio-label">
        <span class="section-index">01</span> The main project
      </p><h2 id="work-title">A closer look at <em>Nyayota.</em></h2><a
        class="text-link"
        href="/projects/"
        >All projects <Icon name="arrow-up-right" size={15} /></a>
    </div>
    {
      projects.map((project, index) => (
        <article class="work-feature" data-project>
          {project.data.cover && (
            <a
              class="work-image-link"
              href={`/projects/${project.id}/`}
              aria-label={`Explore ${project.data.title}`}
              data-motion="image"
            >
              <div class="work-image-stage">
                <div class="work-browser-bar" aria-hidden="true">
                  <span class="browser-dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span>{project.data.title} / a closer look</span>
                  <Icon name="arrow-up-right" size={14} />
                </div>
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt ?? project.data.title}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 80rem) 74rem, 92vw"
                  loading="lazy"
                  class="work-image"
                />
              </div>
              <span class="work-image-caption">
                Explore the project <Icon name="arrow-up-right" size={18} />
              </span>
            </a>
          )}
          <div class="work-details" data-motion="stagger">
            <div class="work-name">
              <>
                <span class="folio-label">
                  /{String(index + 1).padStart(2, "0")} · {project.data.year}
                </span>
                <h3>
                  <a href={`/projects/${project.id}/`}>
                    {project.data.title}
                    <Icon name="arrow-up-right" size={32} />
                  </a>
                </h3>
                <span class="status status--live">
                  {project.data.status === "live"
                    ? "Live project"
                    : project.data.status}
                </span>
              </>
            </div>
            <div class="work-description">
              <>
                <p>{project.data.summary}</p>
                <ul class="work-stack" aria-label="Technologies">
                  {project.data.stack.slice(0, 4).map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
                <a class="text-link" href={`/projects/${project.id}/`}>
                  Read the case study <Icon name="arrow-right" size={16} />
                </a>
              </>
            </div>
          </div>
        </article>
      ))
    }
    {
      projects.length === 0 && (
        <p class="empty-state">Published projects will appear here.</p>
      )
    }
  </section>

  <section class="home-perspective" aria-labelledby="perspective-title">
    <div class="container learning-desk">
      <div class="learning-desk__intro">
        <p class="folio-label">Alongside the build</p><h2
          id="perspective-title"
        >
          A practice,<br /><em>not a finished picture.</em>
        </h2><p>
          Legal information needs structure. A reading interface needs care.
          These are the questions behind the work — and the skills I am still
          developing.
        </p><a class="text-link" href="/about/"
          >More about my approach <Icon name="arrow-up-right" size={16} /></a>
      </div>
      <ol class="learning-ledger">
        {
          learning.map((entry) => (
            <li>
              <>
                <div class="ledger-meta">
                  <>
                    <span>{timelineStateLabels[entry.state]}</span>
                    <time datetime={entry.date}>{entry.date}</time>
                  </>
                </div>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-record container" aria-labelledby="record-title">
    <div class="folio-section-head" data-motion="reveal">
      <p class="folio-label">
        <span class="section-index">02</span> Public record
      </p><h2 id="record-title">The work, <em>with its sources.</em></h2><a
        class="text-link"
        href="/vault/"
        >Open the vault <Icon name="arrow-up-right" size={15} /></a>
    </div>
    <div class="record-grid">
      <div class="record-evidence" data-motion="stagger">
        <p class="folio-label">Sources, not just statements</p>
        {
          evidence.map((item) => (
            <a
              class="record-row"
              href={item.data.link ?? item.data.file ?? "/vault/"}
              target={item.data.link ? "_blank" : undefined}
              rel={item.data.link ? "noopener noreferrer" : undefined}
            >
              <>
                <span>
                  <>
                    <span class="record-date">
                      {formatMonth(item.data.date)} · Public source
                    </span>
                    <span class="record-title">{item.data.title}</span>
                  </>
                </span>
                <Icon name="arrow-up-right" size={20} />
              </>
            </a>
          ))
        }
      </div>
      <div class="record-reading" data-motion="stagger">
        <p class="folio-label">The reading room</p>
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <a class="record-row" href={`/blog/${post.id}/`}>
                <>
                  <span>
                    <>
                      <time
                        class="record-date"
                        datetime={isoDate(post.data.published)}
                      >
                        {formatMonth(post.data.published)}
                      </time>
                      <span class="record-title">{post.data.title}</span>
                    </>
                  </span>
                  <Icon name="arrow-up-right" size={20} />
                </>
              </a>
            ))
          ) : (
            <a class="record-row" href="/blog/">
              <>
                <span>
                  <>
                    <span class="record-date">No articles published yet</span>
                    <span class="record-title">
                      The blog — not published yet
                    </span>
                  </>
                </span>
                <Icon name="arrow-up-right" size={20} />
              </>
            </a>
          )
        }
        {
          writing.length > 0 ? (
            writing.map((piece) => (
              <a
                class="record-row"
                href={
                  piece.data.kind === "book"
                    ? `/writing/book/${piece.data.book}/`
                    : `/writing/${piece.id}/`
                }
              >
                <>
                  <span>
                    <>
                      <span class="record-date">Writing</span>
                      <span class="record-title">{piece.data.title}</span>
                    </>
                  </span>
                  <Icon name="arrow-up-right" size={20} />
                </>
              </a>
            ))
          ) : (
            <a class="record-row" href="/writing/">
              <>
                <span>
                  <>
                    <span class="record-date">No writing published yet</span>
                    <span class="record-title">
                      Longer writing — not published yet
                    </span>
                  </>
                </span>
                <Icon name="arrow-up-right" size={20} />
              </>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="home-contact container" aria-labelledby="contact-title">
    <div class="contact-overline" data-motion="reveal">
      <p class="folio-label">Get in touch</p><a
        class="text-link"
        href="/contact/"
        >All contact channels <Icon name="arrow-up-right" size={15} /></a>
    </div>
    <div data-motion="stagger">
      <h2 id="contact-title">
        Have a question<br /><em>about the work?</em>
      </h2><div class="contact-bottom">
        <p>
          Projects, study opportunities, writing.<br />Email is a good place to
          start.
        </p><a
          href={site.email ? `mailto:${site.email}` : "/contact/"}
          class="contact-email"
          >{site.email ?? "Say hello"}<Icon
            name="arrow-up-right"
            size={22}
          /></a>
      </div>
    </div>
  </section>
</BaseLayout>
