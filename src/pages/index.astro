---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site, socials, isLive } from '../config/site';
import { getFeaturedProjects, getPosts, getPieces, getBooks, getVaultItems, verificationLabels } from '../lib/content';
import { formatMonth, isoDate, readingTime, tagLabel } from '../lib/text';

const projects = await getFeaturedProjects(3);
const posts = (await getPosts()).slice(0, 3);
const pieces = (await getPieces()).slice(0, 2);
const books = (await getBooks()).slice(0, 1);
const vault = (await getVaultItems()).filter((item) => item.data.verification === 'verified').slice(0, 3);
// Books first, then standalone pieces — never the same entry twice.
const writing = [...books, ...pieces.filter((piece) => piece.id !== books[0]?.id)].slice(0, 3);

const email = site.email;
const contactLinks = socials.filter((social) => isLive(social.href)).slice(0, 3);
---

<BaseLayout title={site.title} description={site.description} path="/">
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__main">
        <p class="hero__kicker">
          <span class="hero__dot" aria-hidden="true"></span>
          <span>{site.name}</span>
          <span class="hero__sep" aria-hidden="true">/</span>
          <span>Software &amp; writing</span>
        </p>

        <h1 class="hero__title" id="hero-title">
          I build software that makes useful knowledge
          <em>easier to reach.</em>
        </h1>

        <p class="hero__intro">{site.intro}</p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="/projects/">
            See the work
            <Icon name="arrow-right" size={15} />
          </a>
          <a class="btn" href="/cv/">Read my CV</a>
          <a class="btn btn--ghost" href="/about/">About me</a>
        </div>

        <dl class="hero__facts">
          <div>
            <dt>Currently</dt>
            <dd>{site.status}</dd>
          </div>
          {
            site.location && (
              <div>
                <dt>Based in</dt>
                <dd>{site.location}</dd>
              </div>
            )
          }
          <div>
            <dt>Elsewhere</dt>
            <dd class="hero__links">
              {
                socials.filter((s) => isLive(s.href)).slice(0, 2).map((social) => (
                  <a href={social.href!} rel="me noopener noreferrer" target="_blank">
                    {social.label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
      </div>

      <!-- A printed "index card" rather than a decorative illustration:
           it carries real information the visitor might want next. -->
      <aside class="hero__card" aria-label="At a glance">
        <div class="hero__card-head">
          <span class="mono">Index</span>
          <span class="mono hero__card-year">2026</span>
        </div>
        <ol class="hero__index">
          {
            projects.map((project, i) => (
              <li>
                <a href={`/projects/${project.id}/`}>
                  <span class="hero__index-num mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="hero__index-body">
                    <span class="hero__index-title">{project.data.title}</span>
                    <span class="hero__index-desc">{project.data.summary}</span>
                  </span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))
          }
          <li>
            <a href="/writing/">
              <span class="hero__index-num mono">{String(projects.length + 1).padStart(2, '0')}</span>
              <span class="hero__index-body">
                <span class="hero__index-title">Writing</span>
                <span class="hero__index-desc">Stories, essays and longer work.</span>
              </span>
              <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
        </ol>
        <p class="hero__card-foot">
          <span class="status status--live">Open source</span>
          <span class="mono">Static · no trackers</span>
        </p>
      </aside>
    </div>
  </section>

  <!-- ═══════════════ NOW ═══════════════ -->
  <section class="now" aria-label="What I am working on now">
    <div class="container now__inner">
      <p class="now__label mono">Now</p>
      <div class="now__items">
        <a class="now__item" href="/projects/nyayota/">
          <span class="now__dot" aria-hidden="true"></span>
          <span>Building <strong>Nyayota</strong>, a legal research platform for Bangladesh</span>
          <Icon name="arrow-right" size={14} />
        </a>
        {
          posts[0] && (
            <a class="now__item" href={`/blog/${posts[0].id}/`}>
              <Icon name="book" size={14} />
              <span>Latest note: <strong>{posts[0].data.title}</strong></span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ SELECTED WORK ═══════════════ -->
  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">01 — Selected work</p>
          <h2 id="work-title">Things I have built</h2>
          <p>
            Real projects with real constraints. Each one links to code, a live version, or both.
          </p>
        </div>
        <a class="section-head__link" href="/projects/">
          All projects
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      {
        projects.length > 0 ? (
          <div class="work-grid">
            {projects.map((project, i) => (
              <div class:list={['reveal', i === 0 && 'work-grid__lead']}>
                <ProjectCard project={project} featured={i === 0} index={i + 1} />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-state">
            <strong>No projects published yet</strong>
            Published projects will appear here.
          </p>
        )
      }
    </div>
  </section>

  <!-- ═══════════════ WRITING ═══════════════ -->
  <section class="section section--tight" aria-labelledby="writerly-title">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">02 — Words</p>
          <h2 id="writerly-title">Blog &amp; writing</h2>
          <p>
            Two separate shelves: short notes on building software, and longer creative or
            research work.
          </p>
        </div>
      </div>

      <div class="split">
        <!-- Blog -->
        <div class="split__col">
          <div class="split__head">
            <h3>From the blog</h3>
            <a class="split__more" href="/blog/">All posts <Icon name="arrow-right" size={13} /></a>
          </div>
          {
            posts.length > 0 ? (
              <ul class="entry-list">
                {posts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}/`}>
                      <time datetime={isoDate(post.data.published)} class="entry-list__date">
                        {formatMonth(post.data.published)}
                      </time>
                      <span class="entry-list__body">
                        <span class="entry-list__title">{post.data.title}</span>
                        <span class="entry-list__desc">{post.data.description}</span>
                      </span>
                      <span class="entry-list__meta mono">{readingTime(post.body)} min</span>
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty-state">
                <strong>No posts yet</strong>
                New articles will appear here when published.
              </p>
            )
          }
        </div>

        <!-- Writing -->
        <div class="split__col">
          <div class="split__head">
            <h3>Writing</h3>
            <a class="split__more" href="/writing/">The shelf <Icon name="arrow-right" size={13} /></a>
          </div>
          {
            writing.length > 0 ? (
              <ul class="entry-list">
                {writing.map((piece) => (
                  <li>
                    <a href={`/writing/${piece.data.kind === 'book' ? `book/${piece.data.book}` : piece.id}/`}>
                      <span class="entry-list__date mono">{tagLabel(piece.data.form)}</span>
                      <span class="entry-list__body">
                        <span class="entry-list__title">{piece.data.title}</span>
                        <span class="entry-list__desc">{piece.data.description}</span>
                      </span>
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty-state">
                <strong>Nothing on the shelf yet</strong>
                Published writing will appear here.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ ACHIEVEMENTS ═══════════════ -->
  {
    vault.length > 0 && (
      <section class="section section--tight" aria-labelledby="proof-title">
        <div class="container">
          <div class="section-head">
            <div class="section-head__text">
              <p class="eyebrow">03 — Record</p>
              <h2 id="proof-title">Verified work</h2>
              <p>Documents and evidence kept in the vault, linked to their original source.</p>
            </div>
            <a class="section-head__link" href="/vault/">
              Open the vault
              <Icon name="arrow-right" size={14} />
            </a>
          </div>

          <ul class="proof-grid">
            {vault.map((item) => (
              <li class="proof">
                <div class="proof__top">
                  <span class="chip chip--accent">{verificationLabels[item.data.verification].label}</span>
                  <time datetime={isoDate(item.data.date)} class="mono">{formatMonth(item.data.date)}</time>
                </div>
                <h3 class="proof__title">
                  {item.data.file ? (
                    <a href={item.data.file} target="_blank" rel="noopener noreferrer">{item.data.title}</a>
                  ) : (
                    item.data.title
                  )}
                </h3>
                <p class="proof__desc">{item.data.description}</p>
                {item.data.link && (
                  <a class="proof__link" href={item.data.link} target="_blank" rel="noopener noreferrer">
                    View source
                    <Icon name="arrow-up-right" size={13} />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ═══════════════ CONTACT ═══════════════ -->
  <section class="contact-band" aria-labelledby="contact-title">
    <div class="container contact-band__inner">
      <div class="contact-band__text">
        <p class="eyebrow">04 — Contact</p>
        <h2 id="contact-title">Let&rsquo;s compare notes.</h2>
        <p>
          Open to conversations about projects, study opportunities and writing. The contact page
          has every route that actually works.
        </p>
      </div>
      <div class="contact-band__links">
        {
          email ? (
            <a class="btn btn--primary" href={`mailto:${email}`}>
              <Icon name="mail" size={15} />
              {email}
            </a>
          ) : (
            <a class="btn btn--primary" href="/contact/">
              Contact page
              <Icon name="arrow-right" size={15} />
            </a>
          )
        }
        <ul class="contact-band__socials">
          {contactLinks.map((social) => (
            <li>
              <a href={social.href!} target="_blank" rel="me noopener noreferrer">
                <Icon name={social.icon} size={16} />
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══════════════ HERO ═══════════════ */
  .hero {
    border-block-end: 1px solid var(--line);
    overflow: hidden;
    position: relative;
  }

  /* A faint blueprint grid behind the hero only — gives the page texture
     without a single image request. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: radial-gradient(ellipse 90% 80% at 30% 0%, black, transparent 75%);
    opacity: 0.7;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-2xl);
  }

  .hero__main {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero__dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero__sep {
    color: var(--ink-faint);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    color: var(--accent);
    /* Slight optical correction: italics lean right, so pull back a touch. */
    padding-inline-start: 0.06em;
  }

  .hero__intro {
    max-width: 48ch;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-block-start: 0.35rem;
  }

  .hero__facts {
    display: grid;
    gap: var(--space-sm) var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--line);
  }

  .hero__facts dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-block-end: 0.35rem;
  }

  .hero__facts dd {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
  }

  .hero__links a {
    text-decoration-color: var(--line-strong);
  }

  .hero__links a:hover {
    color: var(--accent);
  }

  /* ── Index card ─────────────────────────────────────────── */
  .hero__card {
    align-self: start;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .hero__card-head,
  .hero__card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    background: var(--bg-sunken);
  }

  .hero__card-head {
    border-block-end: 1px solid var(--line);
  }

  .hero__card-foot {
    border-block-start: 1px solid var(--line);
    gap: var(--space-sm);
  }

  .hero__card-year {
    color: var(--ink-muted);
  }

  .hero__index {
    list-style: none;
    padding: 0;
    counter-reset: none;
  }

  .hero__index li + li {
    border-block-start: 1px solid var(--line);
  }

  .hero__index a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .hero__index a:hover {
    background: var(--bg-hover);
  }

  .hero__index-num {
    font-size: 0.625rem;
    color: var(--ink-faint);
    padding-block-start: 0.25rem;
  }

  .hero__index-body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .hero__index-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--ink);
    line-height: 1.25;
  }

  .hero__index-desc {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero__index a > svg {
    color: var(--ink-faint);
    margin-block-start: 0.2rem;
    transition:
      color var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out);
  }

  .hero__index a:hover > svg {
    color: var(--accent);
    translate: 2px -2px;
  }

  /* ═══════════════ NOW ═══════════════ */
  .now {
    border-block-end: 1px solid var(--line);
    background: var(--bg-sunken);
  }

  .now__inner {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
  }

  .now__label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .now__items {
    display: grid;
    gap: 0.35rem;
  }

  .now__item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.5;
  }

  .now__item strong {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .now__item svg {
    flex: none;
    translate: 0 2px;
    color: var(--ink-faint);
  }

  .now__item:hover {
    color: var(--ink);
  }

  .now__item:hover svg {
    color: var(--accent);
  }

  .now__dot {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--good);
    flex: none;
    translate: 0 -2px;
  }

  /* ═══════════════ WORK GRID ═══════════════ */
  .work-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  /* ═══════════════ SPLIT (blog / writing) ═══════════════ */
  .split {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  .split__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block-end: 0.6rem;
    border-block-end: 1px solid var(--line);
  }

  .split__head h3 {
    font-size: var(--text-md);
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0;
  }

  .split__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .split__more:hover {
    color: var(--accent);
  }

  .entry-list {
    list-style: none;
    padding: 0;
  }

  .entry-list li + li {
    border-block-start: 1px solid var(--line);
  }

  .entry-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'body meta'
      'body arrow';
    align-items: center;
    gap: 0.15rem 0.75rem;
    padding: 0.85rem 0.15rem;
    text-decoration: none;
    color: inherit;
  }

  .entry-list__date {
    display: none;
  }

  .entry-list__body {
    grid-area: body;
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .entry-list__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .entry-list__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .entry-list__meta {
    grid-area: meta;
    font-size: 0.625rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .entry-list a > svg {
    grid-area: arrow;
    color: var(--ink-faint);
    transition:
      color var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out);
  }

  .entry-list a:hover .entry-list__title {
    color: var(--accent);
  }

  .entry-list a:hover > svg {
    color: var(--accent);
    translate: 2px -2px;
  }

  /* ═══════════════ PROOF ═══════════════ */
  .proof-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .proof {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--line-strong);
  }

  .proof__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: 0.625rem;
    color: var(--ink-faint);
  }

  .proof__title {
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .proof__title a {
    text-decoration: none;
  }

  .proof__title a:hover {
    color: var(--accent);
  }

  .proof__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-block-start: 0.25rem;
  }

  .proof__link:hover {
    color: var(--accent);
  }

  /* ═══════════════ CONTACT BAND ═══════════════ */
  .contact-band {
    border-block-start: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 140% at 85% 0%, var(--accent-soft), transparent 70%),
      var(--bg-sunken);
  }

  .contact-band__inner {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
  }

  .contact-band__text {
    display: grid;
    gap: 0.7rem;
    max-width: 46ch;
  }

