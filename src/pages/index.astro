---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config/site";
import { getProjects, statusLabels } from "../lib/content";
import { selectHomeWork } from "../lib/home-work";
import "../styles/home.css";
import Now from "../components/Now.astro";
import NyayotaDemo from "../components/NyayotaDemo.astro";
import { now } from "../data/now";

const { primary, secondary } = selectHomeWork(await getProjects());
const projects = primary ? [primary] : [];
if (now.photo && !now.photoAlt.trim())
  throw new Error("Add an accurate photoAlt for your real portrait.");
---

<BaseLayout title={site.title} description={site.description} path="/">
  <section class="home-hero container" aria-labelledby="hero-title" data-hero>
    <div class="hero-topline" data-enter>
      <p class="folio-label">
        Student <span>Technology &amp; web projects</span>
      </p>
      <p class="folio-label hero-discipline">
        A place to learn, build &amp; document
      </p>
    </div>
    <h1
      class="hero-heading"
      id="hero-title"
      aria-label="Md. Afnan. Building for readers."
    >
      <span aria-hidden="true" class="title-mask"
        ><span data-title-line
          ><span class="hero-word" style="--word-index:0">Md.</span>{" "}<span
            class="hero-word"
            style="--word-index:1">Afnan.</span
          ></span
        ></span
      >
      <span aria-hidden="true" class="title-mask"
        ><em data-title-line
          ><span class="hero-word" style="--word-index:2">Building</span>{
            " "
          }<span class="hero-word" style="--word-index:3">for</span>{" "}<span
            class="hero-word"
            style="--word-index:4">readers.</span
          ></em
        ></span
      >
    </h1>
    <div class="hero-bottom">
      <div class="hero-intro" data-enter>
        <p>{site.intro}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#selected-work"
            >Explore the work <Icon name="arrow-down" size={16} /></a
          >
          <a class="text-link" href="/about/"
            >A little about me <Icon name="arrow-up-right" size={15} /></a
          >
        </div>
      </div>
      <aside class="hero-current" data-enter aria-label="Current work">
        <figure class="portrait">
          {
            now.photo ? (
              <Image
                src={now.photo}
                alt={now.photoAlt}
                width={112}
                height={112}
                widths={[112, 224]}
                sizes="112px"
                format="webp"
              />
            ) : (
              <div class="portrait-placeholder">
                Real photo
                <br />
                placeholder
              </div>
            )
          }
          {
            !now.photo && (
              <figcaption>
                A face to go with the name — photo to add.
              </figcaption>
            )
          }
        </figure>
        <div>
          <p class="folio-label">Current focus</p><p>
            {site.status}
          </p><a class="text-link" href="/projects/nyayota/"
            >Meet Nyayota <Icon name="arrow-up-right" size={14} /></a
          >
        </div>
      </aside>
    </div>
    <div class="hero-baseline" data-enter>
      <span class="folio-label">Still learning. Working in public.</span><a
        href="#selected-work"
        class="folio-label"
        >Selected work <Icon name="arrow-down" size={14} /></a
      >
    </div>
  </section>

  <section
    class="home-work container"
    id="selected-work"
    aria-labelledby="work-title"
  >
    <div class="folio-section-head" data-motion="reveal">
      <p class="folio-label">
        <span class="section-index">01</span> The main project
      </p><h2 id="work-title">Selected work.</h2><a
        class="text-link"
        href="/projects/"
        >All projects <Icon name="arrow-up-right" size={15} /></a
      >
    </div>
    {
      projects.map((project, index) => (
        <article class="work-feature" data-project>
          {project.data.cover && (
            <a
              class="work-image-link"
              href={`/projects/${project.id}/`}
              aria-label={`Explore the project: ${project.data.title}`}
              data-motion="image"
            >
              <div class="work-image-stage">
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt ?? project.data.title}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 80rem) 44rem, (min-width: 48rem) 48vw, calc(100vw - 4rem)"
                  loading="lazy"
                  class="work-image"
                />
              </div>
              <span class="work-image-caption">
                Explore the project <Icon name="arrow-up-right" size={18} />
              </span>
            </a>
          )}
          <div class="work-details" data-motion="stagger">
            <div class="work-name">
              <>
                <span class="folio-label">
                  /{String(index + 1).padStart(2, "0")} · {project.data.year}
                </span>
                <h3>
                  <a href={`/projects/${project.id}/`}>
                    {project.data.title}
                    <Icon name="arrow-up-right" size={32} />
                  </a>
                </h3>
                <span
                  class:list={[
                    "status",
                    project.data.status === "in-progress"
                      ? "status--in-progress"
                      : "status--live",
                  ]}
                >
                  {statusLabels[project.data.status]}
                </span>
              </>
            </div>
            <div class="work-description">
              <>
                <p>{project.data.summary}</p>
                <ul class="work-stack" aria-label="Technologies">
                  {project.data.stack.slice(0, 4).map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
                <a class="text-link" href={`/projects/${project.id}/`}>
                  Read the case study <Icon name="arrow-right" size={16} />
                </a>
                {project.data.links.repo && (
                  <a
                    class="text-link work-source"
                    href={project.data.links.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Source &amp; documentation{" "}
                    <Icon name="arrow-up-right" size={15} />
                  </a>
                )}
              </>
            </div>
          </div>
        </article>
      ))
    }
    {primary?.id === "nyayota" && <NyayotaDemo />}
    {
      projects.length === 0 && (
        <p class="empty-state">Published projects will appear here.</p>
      )
    }
  </section>

  {
    secondary.length > 0 && (
      <section
        class="container secondary-work"
        aria-labelledby="secondary-title"
      >
        <h2 id="secondary-title">Other work</h2>
        {secondary.map((project) => (
          <a class="secondary-work__row" href={`/projects/${project.id}/`}>
            <span>
              <strong>{project.data.title}</strong>
              <span>{project.data.summary}</span>
            </span>
            <Icon name="arrow-up-right" size={20} />
          </a>
        ))}
      </section>
    )
  }

  <Now />

  <section class="home-contact container" aria-labelledby="contact-title">
    <div class="contact-overline" data-motion="reveal">
      <p class="folio-label">Get in touch</p><a
        class="text-link"
        href="/contact/"
        >All contact channels <Icon name="arrow-up-right" size={15} /></a
      >
    </div>
    <div data-motion="stagger">
      <h2 id="contact-title">
        Have a question<br /><em>about the work?</em>
      </h2><div class="contact-bottom">
        <p>
          Projects, study opportunities, writing.<br />Email is a good place to
          start.
        </p><a
          href={site.email ? `mailto:${site.email}` : "/contact/"}
          class="contact-email"
          >{site.email ?? "Say hello"}<Icon
            name="arrow-up-right"
            size={22}
          /></a
        >
      </div>
    </div>
  </section>
</BaseLayout>
