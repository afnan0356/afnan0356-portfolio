---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";
import { getProjects, statusLabels } from "../../lib/content";
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="A project archive: purpose, implementation, source code, and the limits of the work."
  path="/projects/"
>
  <div class="container">
    <PageHeader
      eyebrow="Project archive"
      title="Projects I am learning through."
      lede="Nyayota is my main ongoing project. This archive explains its purpose, the direction I contribute, the AI-assisted implementation and what still needs work."
    />
  </div>
  <div class="container archive-entries" id="case-studies">
    {
      projects.map((project, index) => (
        <article class="archive-entry">
          <div class="archive-entry__heading">
            <>
              <span class="folio-label">
                {String(index + 1).padStart(2, "0")} / {project.data.year} /{" "}
                {statusLabels[project.data.status]}
              </span>
              <h2>
                <a href={`/projects/${project.id}/`}>
                  {project.data.title}
                  <Icon name="arrow-up-right" size={26} />
                </a>
              </h2>
              <p>{project.data.summary}</p>
              {project.data.statusNote && (
                <p class="archive-status-note">{project.data.statusNote}</p>
              )}
              <ul class="inline-stack" aria-label="Technologies">
                {project.data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="text-link" href={`/projects/${project.id}/`}>
                {project.data.caseStudy
                  ? "Read the case study"
                  : "View project"}{" "}
                <Icon name="arrow-right" size={16} />
              </a>
              <div
                class="archive-shortcuts"
                aria-label={`${project.data.title} reading shortcuts`}
              >
                {project.data.caseStudy?.role && (
                  <a href={`/projects/${project.id}/#role`}>
                    Role &amp; process
                  </a>
                )}
                {(project.data.caseStudy?.decisions?.length ?? 0) > 0 && (
                  <a href={`/projects/${project.id}/#decisions`}>
                    Technical decisions
                  </a>
                )}
                {(project.data.caseStudy?.limitations?.length ?? 0) > 0 && (
                  <a href={`/projects/${project.id}/#scope`}>
                    Status &amp; limits
                  </a>
                )}
              </div>
            </>
          </div>
          {project.data.cover && (
            <a
              class="archive-entry__image"
              href={`/projects/${project.id}/`}
              aria-label={`Actual project interface: ${project.data.title}`}
              data-motion="image"
            >
              <Image
                src={project.data.cover}
                alt={project.data.coverAlt ?? project.data.title}
                widths={[480, 800, 1200]}
                sizes="(min-width: 80rem) 42rem, (min-width: 48rem) 52vw, calc(100vw - 4rem)"
                loading="eager"
              />
              <span>
                Actual project interface{" "}
                <Icon name="arrow-up-right" size={16} />
              </span>
            </a>
          )}
        </article>
      ))
    }
    {
      projects.length === 0 && (
        <p class="empty-state">No projects published yet.</p>
      )
    }
  </div>
  <section class="container editorial-next">
    <p class="folio-label">This site is part of the practice</p><h2>
      A smaller build.<br /><em>The same attention to reading.</em>
    </h2><p>
      This portfolio uses Astro, TypeScript and file-based publishing. Its
      source is public; the learning timeline records what is still being worked
      on.
    </p><div>
      <a
        class="text-link"
        href="https://github.com/afnan0356/afnan0356-portfolio"
        target="_blank"
        rel="noopener noreferrer"
        >Browse this site’s source <Icon name="arrow-up-right" size={16} /></a
      ><a class="text-link" href="/vault/#progress"
        >Learning &amp; progress <Icon name="arrow-right" size={16} /></a
      >
    </div>
  </section>
</BaseLayout>
