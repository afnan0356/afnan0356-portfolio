---
/** Real contact routes plus an explicit email-app composer; no pretend delivery. */
import ContactForm from "../components/ContactForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { site, socials, featuredLinks, isLive } from "../config/site";

const allSocials = socials.filter(
  (social) => social.inContact && isLive(social.href),
);
---

<BaseLayout
  title="Contact"
  description="How to get in touch with Md. Afnan."
  path="/contact/"
>
  <div class="container">
    <PageHeader
      eyebrow="Contact"
      title="Say hello"
      lede="Open to conversations about projects, collaboration, study opportunities and writing. Email is a good place to start."
    />
  </div>

  <div class="container">
    <div class="contact">
      <!-- ── Primary route ───────────────────────────────── -->
      <section class="contact__primary" aria-labelledby="email-title">
        {
          site.email ? (
            <>
              <h2 id="email-title" class="contact__label mono">
                Email
              </h2>
              <a class="contact__email" href={`mailto:${site.email}`}>
                {site.email}
                <Icon name="arrow-up-right" size={18} />
              </a>
              <div class="contact__actions">
                <a
                  class="btn btn--primary btn--sm"
                  href={`mailto:${site.email}`}
                >
                  <Icon name="mail" size={14} />
                  Write an email
                </a>
                <button
                  class="btn btn--sm"
                  type="button"
                  data-copy={site.email}
                  data-label="Copy address"
                >
                  Copy address
                </button>
                <span
                  class="contact__copy-status"
                  data-copy-status
                  role="status"
                  aria-live="polite"
                  aria-atomic="true"
                />
              </div>
            </>
          ) : (
            <>
              <h2 id="email-title" class="contact__label mono">
                Email
              </h2>
              <p class="contact__pending">
                Use one of the public channels below to get in touch.
              </p>
            </>
          )
        }
      </section>

      <!-- ── Other routes ────────────────────────────────── -->
      <section class="contact__routes" aria-labelledby="routes-title">
        <h2 id="routes-title" class="contact__label mono">Elsewhere</h2>
        <ul class="route-list">
          {
            allSocials.map((social) => (
              <li>
                <a
                  href={social.href!}
                  target="_blank"
                  rel="me noopener noreferrer"
                >
                  <span class="route-list__icon">
                    <Icon name={social.icon} size={16} />
                  </span>
                  <span class="route-list__body">
                    <span class="route-list__label">{social.label}</span>
                    <span class="route-list__value mono">
                      {social.href!.replace(/^https?:\/\//, "")}
                    </span>
                  </span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))
          }
          {
            featuredLinks.map((link) => (
              <li class="route-list__project">
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <span class="route-list__icon">
                    <Icon name="globe" size={16} />
                  </span>
                  <span class="route-list__body">
                    <span class="route-list__label">{link.label}</span>
                    <span class="route-list__value mono">
                      {link.description}
                    </span>
                  </span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ── When to write ─────────────────────────────────── -->
      <section class="when" aria-labelledby="when-title">
        <h2 id="when-title">What is useful to include</h2>
        <ul>
          <li>
            <h3>A specific subject line</h3>
            <p>
              For example, “Question about Nyayota’s search” explains the
              context straight away.
            </p>
          </li>
          <li>
            <h3>What you have already tried</h3>
            <p>Links, screenshots or the exact wording that confused you.</p>
          </li>
          <li>
            <h3>What you need back</h3>
            <p>
              An answer, a review, a fix, or an introduction — the clearer the
              better.
            </p>
          </li>
        </ul>
      </section>
    </div>
  </div>
  <div class="container"><ContactForm /></div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-sm) var(--space-md);
  }

  .contact__label {
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-block-end: var(--space-sm);
  }

  /* ── Primary panel ──────────────────────────────────────── */
  .contact__primary {
    border-block: 1px solid var(--line-strong);
    padding: var(--space-lg) 0;
    background: none;
    align-self: start;
  }

  .contact__actions .btn {
    min-block-size: 2.75rem;
  }

  .contact__copy-status {
    flex-basis: 100%;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .contact__email {
    max-inline-size: 100%;
    min-block-size: 2.75rem;
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    word-break: break-word;
  }

  .contact__email:hover {
    color: var(--accent);
  }

  .contact__email svg {
    flex: none;
    color: var(--accent);
  }

  .contact__pending {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 44ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: var(--space-md);
  }

  /* ── Routes ─────────────────────────────────────────────── */
  .route-list {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--line);
  }

  .route-list li {
    border-block-end: 1px solid var(--line);
  }

  .route-list a {
    min-block-size: 4.5rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.85rem 0.15rem;
    text-decoration: none;
    color: inherit;
  }

  .route-list a:hover .route-list__label {
    color: var(--accent);
  }

  .route-list__icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--ink-soft);
  }

  .route-list__body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .route-list__label {
    font-size: 1rem;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .route-list__value {
    font-size: 0.75rem;
    color: var(--ink-muted);
    overflow-wrap: anywhere;
    line-height: 1.6;
  }

  .route-list a > svg {
    color: var(--ink-muted);
    flex: none;
  }

  .contact__note {
    margin-block-start: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 52ch;
  }

  /* ── When ───────────────────────────────────────────────── */
  .when {
    margin-block-start: 1rem;
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--line);
  }

  .when h2 {
    font-size: var(--text-lg);
    margin-block-end: var(--space-md);
  }

  .when ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .when h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    margin-block-end: 0.3rem;
  }

  .when p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 34ch;
  }

  .route-list__project .route-list__label {
    font-size: 0.875rem;
  }
  .route-list__project {
    background: var(--bg-raised);
  }
  .route-list a {
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .route-list a:hover {
    background: var(--bg-hover);
  }
  @media (min-width: 56rem) {
    .contact__routes {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .when {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0;
    }
    .when ul {
      grid-template-columns: 1fr;
    }
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 2rem 4rem;
    }

    .contact__primary {
      padding: 2rem 0;
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
