---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import { getPosts, getPostTags } from '../../../lib/content';
import { formatMonth, isoDate, readingTime } from '../../../lib/text';

export async function getStaticPaths() {
  const tags = await getPostTags();
  const posts = await getPosts();
  return tags.map(({ tag, count }) => ({
    params: { tag },
    props: {
      tag,
      count,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  count: number;
  posts: Awaited<ReturnType<typeof getPosts>>;
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Posts tagged “${tag}”`}
  description={`Writing tagged ${tag}.`}
  path={`/blog/tag/${tag}/`}
>
  <div class="container container--text">
    <PageHeader
      eyebrow="Blog · Tag"
      title={tag}
      lede={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged “${tag}”.`}
    >
      <div class="page-header__actions">
        <a class="btn btn--sm" href="/blog/">
          <Icon name="arrow-left" size={14} />
          All posts
        </a>
      </div>
    </PageHeader>

    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}/`}>
            <time class="post-row__date mono" datetime={isoDate(post.data.published)}>
              {formatMonth(post.data.published)}
            </time>
            <span class="post-row__title">{post.data.title}</span>
            <span class="post-row__read mono">{readingTime(post.body)} min</span>
            <Icon name="arrow-up-right" size={15} />
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .post-list {
    border-block-start: 1px solid var(--line);
  }

  .post-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'title read arrow';
    align-items: center;
    gap: var(--space-sm);
    padding: 0.95rem 0.2rem;
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .post-row:hover {
    background: var(--bg-hover);
  }

  .post-row__title {
    grid-area: title;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .post-row:hover .post-row__title {
    color: var(--accent);
  }

  .post-row__date {
    grid-area: date;
    display: none;
    font-size: 0.6875rem;
    color: var(--ink-faint);
  }

  .post-row__read {
    grid-area: read;
    font-size: 0.625rem;
    color: var(--ink-faint);
  }

  .post-row svg {
    grid-area: arrow;
    color: var(--ink-faint);
  }

  @media (min-width: 40rem) {
    .post-row {
      grid-template-columns: 6rem 1fr auto auto;
      grid-template-areas: 'date title read arrow';
    }

    .post-row__date {
      display: block;
    }
  }
</style>
