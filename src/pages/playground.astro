---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperimentArt from "../components/ExperimentArt.astro";
import Icon from "../components/Icon.astro";
import { experiments, sampleNote } from "../data/playground";
---

<BaseLayout
  title="Playground — interface studies & sample writing"
  description="A clearly labelled collection of fictional interface studies, sample writing and a small local word counter."
  path="/playground/"
  noindex
>
  <div class="container playground-page">
    <header class="playground-hero">
      <a class="text-link" href="/">
        ← Back to the portfolio
      </a>
      <p class="folio-label">A small experimental corner</p>
      <h1>
        Not everything needs
        <br />
        to be <em>finished.</em>
      </h1>
      <p>
        Some things just need a little room to play. Explore a few interface
        ideas, read a sample essay, or try a tiny tool.
      </p>
      <div class="playground-notice">
        <span class="sample-pill">Demo content</span>
        <p>
          These are fictional design studies and sample text—not shipped
          products, client work or personal experiences. Nothing here saves your
          input or sends it anywhere.
        </p>
      </div>
    </header>
    <nav class="playground-jumps" aria-label="Playground sections">
      <a href="#studies">01 / Interface studies</a>
      <a href="#reading">02 / Reading room</a>
      <a href="#tool">03 / Tiny tool</a>
    </nav>
    <section
      id="studies"
      aria-labelledby="studies-title"
      class="playground-section"
    >
      <div class="playground-section-heading">
        <p class="folio-label">01 / Look around</p>
        <h2 id="studies-title">Interfaces with a little personality.</h2>
        <p>
          Original, lightweight CSS illustrations. Open each concept for the
          design intent.
        </p>
      </div>
      <div class="experiment-grid">
        {experiments.map((item) => (
          <article class="experiment-card" id={item.id}>
            <ExperimentArt variant={item.style} />
            <div class="experiment-caption">
              <div>
                <p class="folio-label">{item.category} · Fictional concept</p>
                <h3>{item.name}</h3>
              </div>
              <span class="experiment-number" aria-hidden="true">
                {item.number}
              </span>
            </div>
            <p class="experiment-description">{item.description}</p>
            <details class="study-details">
              <summary>
                Behind the idea <span aria-hidden="true">+</span>
              </summary>
              <p>{item.detail}</p>
            </details>
          </article>
        ))}
      </div>
    </section>
    <section
      id="reading"
      class="playground-section"
      aria-labelledby="reading-heading"
    >
      <div class="playground-section-heading">
        <p class="folio-label">02 / The reading room</p>
        <h2 id="reading-heading">Words deserve good company.</h2>
        <p>Try the type controls. They work without JavaScript, too.</p>
      </div>
      <div class="reading-study">
        <fieldset class="reading-size">
          <legend>Reading size</legend>
          <input type="radio" name="reading-size" id="size-regular" checked />
          <label for="size-regular">Regular</label>
          <input type="radio" name="reading-size" id="size-large" />
          <label for="size-large">Large</label>
          <article class="sample-essay">
            <p class="folio-label">Sample essay · No publication date</p>
            <h3>{sampleNote.title}</h3>
            <p class="sample-essay-intro">{sampleNote.intro}</p>
            <div class="sample-essay-body">
              {sampleNote.paragraphs.map((text, i) => (
                <>
                  <p>{text}</p>
                  {i === 1 && (
                    <blockquote>
                      Not less to say.
                      <br />
                      <em>More room to hear it.</em>
                    </blockquote>
                  )}
                </>
              ))}
            </div>
            <p class="essay-end">
              ✳ <span>End of the sample. A little breathing room.</span>
            </p>
          </article>
        </fieldset>
      </div>
    </section>
    <section id="tool" class="playground-section" aria-labelledby="tool-title">
      <div class="playground-section-heading">
        <p class="folio-label">03 / A tiny, working tool</p>
        <h2 id="tool-title">Make a little space for a thought.</h2>
        <p>A local word counter. No sign-in, no saving, no server.</p>
      </div>
      <word-counter class="word-tool">
        <label for="word-draft">Your scratchpad</label>
        <textarea
          id="word-draft"
          autocomplete="off"
          rows="6"
          placeholder="A thought, a sentence, the beginning of something…"
          aria-describedby="word-privacy"
        >Small beginnings are still beginnings.</textarea>
        <div class="word-tool-bottom">
          <output aria-live="polite" aria-atomic="true">
            Enable JavaScript for the live count.
          </output>
          <button type="button" data-clear hidden>
            Clear text
          </button>
        </div>
        <p id="word-privacy">
          Not saved by this site or sent anywhere. Keep your own copy before
          leaving.
        </p>
      </word-counter>
    </section>
    <aside class="playground-exit">
      <p class="folio-label">Back to the real thing</p>
      <h2>Curious about the actual work?</h2>
      <p>
        Nyayota is the documented project. These demos are just here to explore
        the possibilities.
      </p>
      <a class="btn btn--primary" href="/projects/nyayota/">
        Explore Nyayota <Icon name="arrow-up-right" size={16} />
      </a>
    </aside>
  </div>
</BaseLayout>
<script>
  class WordCounter extends HTMLElement {
    private cleanup?: AbortController;
    connectedCallback() {
      this.cleanup?.abort();
      const controller = new AbortController();
      this.cleanup = controller;
      const input = this.querySelector("textarea");
      const output = this.querySelector("output");
      const clear = this.querySelector<HTMLButtonElement>("[data-clear]");
      if (!input || !output || !clear) return;
      const update = () => {
        const text = input.value.trim();
        const words = text ? text.split(/\s+/u).length : 0;
        const characters = Array.from(input.value).length;
        output.textContent = `${words} ${words === 1 ? "word" : "words"} · ${characters} ${characters === 1 ? "character" : "characters"}`;
      };
      input.addEventListener("input", update, { signal: controller.signal });
      clear.addEventListener(
        "click",
        () => {
          input.value = "";
          update();
          input.focus();
        },
        { signal: controller.signal },
      );
      clear.hidden = false;
      update();
    }
    disconnectedCallback() {
      this.cleanup?.abort();
    }
  }
  if (!customElements.get("word-counter"))
    customElements.define("word-counter", WordCounter);
</script>
