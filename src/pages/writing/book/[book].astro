---
/**
 * Book overview — the title page: description, contents, and a way in.
 * Generated from the entry with `kind: book` and matching `book` slug.
 */
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Prose from '../../../components/Prose.astro';
import DemoBanner from '../../../components/DemoBanner.astro';
import Icon from '../../../components/Icon.astro';
import { getBooks, getChapters, isDemo, formLabels, chapterSlug } from '../../../lib/content';
import { formatMonth, isoDate, readingTime } from '../../../lib/text';

export async function getStaticPaths() {
  const books = await getBooks();
  const chapters = await Promise.all(books.map((book) => getChapters(book.data.book ?? book.id)));

  return books.map((book, i) => ({
    params: { book: book.data.book ?? book.id },
    props: { book, chapters: chapters[i] },
  }));
}

interface Props {
  book: Awaited<ReturnType<typeof getBooks>>[number];
  chapters: Awaited<ReturnType<typeof getChapters>>;
}

const { book, chapters } = Astro.props;
const { Content } = await render(book);
const slug = book.data.book ?? book.id;
const first = chapters[0];
const totalMinutes = chapters.reduce((total, chapter) => total + readingTime(chapter.body), 0);
---

<BaseLayout
  title={book.data.title}
  description={book.data.description}
  path={`/writing/book/${slug}/`}
  type="article"
  published={book.data.published}
  updated={book.data.updated}
  noindex={isDemo(book)}
>
  <div class="container container--text">
    <a class="back-link" href="/writing/">
      <Icon name="arrow-left" size={14} />
      The shelf
    </a>

    {isDemo(book) && <DemoBanner kind="book" />}

    <header class="book-head">
      <p class="book-head__form mono">{formLabels[book.data.form] ?? 'Book'}</p>
      <h1 class="book-head__title">{book.data.title}</h1>
      <p class="book-head__desc">{book.data.description}</p>
      <p class="book-head__meta mono">
        <span>{chapters.length} {chapters.length === 1 ? 'chapter' : 'chapters'}</span>
        <span aria-hidden="true">·</span>
        <span>~{Math.max(1, Math.round(totalMinutes))} min</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(book.data.published)}>{formatMonth(book.data.published)}</time>
      </p>
      {
        first && (
          <a class="btn btn--primary book-head__start" href={`/writing/book/${slug}/chapter/${chapterSlug(first)}/`}>
            Start reading
            <Icon name="arrow-right" size={15} />
          </a>
        )
      }
      {chapters.length === 0 && (
        <p class="empty-state">
          <strong>No chapters published yet</strong>
          Published chapters will appear here.
        </p>
      )}
    </header>

    <hr class="rule" />

    <div class="book-about">
      <Prose>
        <Content />
      </Prose>
    </div>

    {
      chapters.length > 0 && (
        <nav class="contents" aria-labelledby="contents-title">
          <h2 id="contents-title" class="contents__title mono">
            Contents
          </h2>
          <ol>
            {chapters.map((chapter) => (
              <li>
                <a href={`/writing/book/${slug}/chapter/${chapterSlug(chapter)}/`}>
                  <span class="contents__num mono">
                    {String(chapter.data.chapter).padStart(2, '0')}
                  </span>
                  <span class="contents__name">{chapter.data.title}</span>
                  <span class="contents__dots" aria-hidden="true"></span>
                  <span class="contents__time mono">{readingTime(chapter.body)} min</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: var(--space-md) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .book-head {
    display: grid;
    gap: 0.75rem;
    padding-block: var(--space-sm) var(--space-md);
  }

  .book-head__form {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .book-head__title {
    font-size: var(--text-3xl);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .book-head__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 50ch;
  }

  .book-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  .book-head__start {
    justify-self: start;
    margin-block-start: 0.35rem;
  }

  .rule {
    height: 1px;
    border: 0;
    background: var(--line);
    margin-block: var(--space-sm) var(--space-lg);
  }

  .book-about {
    max-width: var(--measure);
  }

  /* ── Contents ───────────────────────────────────────────── */
  .contents {
    margin-block: var(--space-xl) var(--space-2xl);
    border-block-start: 1px solid var(--line-strong);
    padding-block-start: var(--space-md);
  }

  .contents__title {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-block-end: var(--space-sm);
  }

  .contents ol {
    list-style: none;
    padding: 0;
    counter-reset: chapter;
  }

  .contents li + li {
    border-block-start: 1px solid var(--line);
  }

  .contents a {
    display: grid;
    grid-template-columns: 2rem auto 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 0.15rem;
    text-decoration: none;
    color: inherit;
  }

  .contents a:hover .contents__name {
    color: var(--accent);
  }

  .contents__num {
    font-size: 0.625rem;
    color: var(--ink-faint);
  }

  .contents__name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contents__dots {
    border-block-end: 1px dotted var(--line-strong);
    translate: 0 -0.25rem;
    min-inline-size: 1rem;
  }

  .contents__time {
    font-size: 0.625rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
</style>
