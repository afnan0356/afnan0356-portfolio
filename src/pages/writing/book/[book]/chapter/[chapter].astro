---
/**
 * Chapter reader — one page per chapter, with previous/next links that
 * follow the published order. Draft chapters disappear from this chain
 * automatically because getChapters() filters them.
 */
import { render } from "astro:content";
import PostTools from "../../../../../components/PostTools.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Prose from "../../../../../components/Prose.astro";
import DemoBanner from "../../../../../components/DemoBanner.astro";
import Icon from "../../../../../components/Icon.astro";
import {
  getBooks,
  getChapters,
  isDemo,
  chapterSlug,
} from "../../../../../lib/content";
import { readingTime } from "../../../../../lib/text";

export async function getStaticPaths() {
  const books = await getBooks();
  const pages: {
    params: { book: string; chapter: string };
    props: {
      book: (typeof books)[number];
      chapter: Awaited<ReturnType<typeof getChapters>>[number];
      chapters: Awaited<ReturnType<typeof getChapters>>;
      position: number;
      prev: Awaited<ReturnType<typeof getChapters>>[number] | null;
      next: Awaited<ReturnType<typeof getChapters>>[number] | null;
    };
  }[] = [];

  for (const book of books) {
    const slug = book.data.book ?? book.id;
    const chapters = await getChapters(slug);

    chapters.forEach((chapter, index) => {
      pages.push({
        params: { book: slug, chapter: chapterSlug(chapter) },
        props: {
          book,
          chapter,
          chapters,
          position: index,
          prev: chapters[index - 1] ?? null,
          next: chapters[index + 1] ?? null,
        },
      });
    });
  }

  return pages;
}

interface Props {
  book: Awaited<ReturnType<typeof getBooks>>[number];
  chapter: Awaited<ReturnType<typeof getChapters>>[number];
  chapters: Awaited<ReturnType<typeof getChapters>>;
  position: number;
  prev: Awaited<ReturnType<typeof getChapters>>[number] | null;
  next: Awaited<ReturnType<typeof getChapters>>[number] | null;
}

const { book, chapter, position, prev, next, chapters } = Astro.props;
const { Content } = await render(chapter);
const slug = book.data.book ?? book.id;
const minutes = readingTime(chapter.body);
const progress = Math.round(
  ((position + 1) / Math.max(chapters.length, 1)) * 100,
);
---

<BaseLayout
  title={`${chapter.data.title} — ${book.data.title}`}
  description={chapter.data.description}
  path={`/writing/book/${slug}/chapter/${chapterSlug(chapter)}/`}
  type="article"
  published={chapter.data.published}
  noindex={isDemo(chapter)}
>
  <div class="container container--text" data-reading-article>
    <PostTools />
    <nav class="chapter-nav" aria-label="Book navigation">
      <a class="chapter-nav__book" href={`/writing/book/${slug}/`}>
        <Icon name="arrow-left" size={13} />
        {book.data.title}
      </a>
      <span class="chapter-nav__count mono">
        {position + 1} / {chapters.length}
      </span>
    </nav>

    {isDemo(chapter) && <DemoBanner kind="chapter" />}

    <header class="chapter-head">
      <p class="chapter-head__label mono">
        Chapter {chapter.data.chapter}
        <span aria-hidden="true">·</span>
        {minutes} min
      </p>
      <h1 class="chapter-head__title">{chapter.data.title}</h1>
    </header>

    <Prose tone="reading">
      <Content />
    </Prose>

    <nav class="chapter-pager" aria-label="Chapter navigation">
      {
        prev ? (
          <a
            class="chapter-pager__link"
            href={`/writing/book/${slug}/chapter/${chapterSlug(prev)}/`}
            rel="prev"
          >
            <span class="mono">Previous chapter</span>
            <span class="chapter-pager__title">
              <Icon name="arrow-left" size={14} />
              {prev.data.title}
            </span>
          </a>
        ) : (
          <a class="chapter-pager__link" href={`/writing/book/${slug}/`}>
            <span class="mono">Back to</span>
            <span class="chapter-pager__title">
              <Icon name="arrow-left" size={14} />
              Contents
            </span>
          </a>
        )
      }
      {
        next ? (
          <a
            class="chapter-pager__link chapter-pager__link--next"
            href={`/writing/book/${slug}/chapter/${chapterSlug(next)}/`}
            rel="next"
          >
            <span class="mono">Next chapter</span>
            <span class="chapter-pager__title">
              {next.data.title}
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ) : (
          <a
            class="chapter-pager__link chapter-pager__link--next"
            href={`/writing/book/${slug}/`}
          >
            <span class="mono">The end</span>
            <span class="chapter-pager__title">
              Back to contents
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        )
      }
    </nav>

    <p class="chapter-footnote mono" style={`--progress:${progress}%`}>
      {progress}% through {book.data.title}
    </p>
  </div>
</BaseLayout>

<style>
  .chapter-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md) var(--space-sm);
  }

  .chapter-nav__book {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .chapter-nav__book:hover {
    color: var(--accent);
  }

  .chapter-nav__count {
    font-size: 0.625rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }

  .chapter-head {
    display: grid;
    gap: 0.5rem;
    padding-block: var(--space-sm) var(--space-lg);
    border-block-end: 1px solid var(--line);
    margin-block-end: var(--space-lg);
  }

  .chapter-head__label {
    display: flex;
    gap: 0.4rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .chapter-head__title {
    font-size: var(--text-2xl);
    line-height: 1.06;
  }

  /* ── Pager ──────────────────────────────────────────────── */
  .chapter-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-2xl) var(--space-md);
    border-block-start: 1px solid var(--line);
    padding-block-start: var(--space-md);
  }

  .chapter-pager__link {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem 0;
  }

  .chapter-pager__link .mono {
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .chapter-pager__title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .chapter-pager__link:hover .chapter-pager__title {
    color: var(--accent);
  }

  .chapter-pager__link--next {
    text-align: end;
    justify-items: end;
  }

  .chapter-footnote {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-block-end: var(--space-lg);
  }
</style>
