---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getBooks, getPieces, getChapters, isDemo, formLabels, chapterSlug } from '../../lib/content';
import { formatMonth, isoDate, readingTime } from '../../lib/text';

const books = await getBooks();
const pieces = await getPieces();

// Chapter counts for the book cards.
const bookDetails = await Promise.all(
  books.map(async (book) => ({
    book,
    chapters: await getChapters(book.data.book ?? book.id),
  })),
);
---

<BaseLayout
  title="Writing"
  description="Stories, essays and longer work — fiction and non-fiction kept separate from the blog."
  path="/writing/"
>
  <div class="container">
    <PageHeader
      eyebrow="Writing"
      title="The shelf"
      lede="Longer work: fiction, essays and notes that are not about software. Books are read chapter by chapter, with a quiet layout built for reading rather than skimming."
      meta={`${bookDetails.length} ${bookDetails.length === 1 ? 'book' : 'books'} · ${pieces.length} ${pieces.length === 1 ? 'piece' : 'pieces'}`}
    />
  </div>

  <!-- ── Books ─────────────────────────────────────────────── -->
  {
    bookDetails.length > 0 && (
      <section class="section section--tight" aria-labelledby="books-title">
        <div class="container">
          <h2 id="books-title" class="rule-label">
            Books
          </h2>
          <div class="shelf">
            {bookDetails.map(({ book, chapters }) => (
              <article class="book-card">
                <div class="book-card__spine" aria-hidden="true">
                  <span class="book-card__spine-text">{book.data.title}</span>
                </div>
                <div class="book-card__body">
                  <div class="book-card__meta mono">
                    <span>{formLabels[book.data.form] ?? 'Book'}</span>
                    {isDemo(book) && <span class="chip">Sample</span>}
                  </div>
                  <h3 class="book-card__title">
                    <a href={`/writing/book/${book.data.book}/`}>{book.data.title}</a>
                  </h3>
                  <p class="book-card__desc">{book.data.description}</p>
                  <div class="book-card__foot">
                    <span class="mono">
                      {chapters.length} {chapters.length === 1 ? 'chapter' : 'chapters'}
                      {chapters.length > 0 && ` · ${Math.max(1, Math.round(chapters.reduce((total, chapter) => total + readingTime(chapter.body), 0)))} min`}
                    </span>
                    <a class="book-card__link" href={`/writing/book/${book.data.book}/`}>
                      Start reading
                      <Icon name="arrow-right" size={14} />
                    </a>
                  </div>
                  {chapters.length > 0 && (
                    <ol class="book-card__chapters">
                      {chapters.slice(0, 4).map((chapter) => (
                        <li>
                          <a href={`/writing/book/${book.data.book}/chapter/${chapterSlug(chapter)}/`}>
                            <span class="mono">{String(chapter.data.chapter).padStart(2, '0')}</span>
                            <span>{chapter.data.title}</span>
                          </a>
                        </li>
                      ))}
                      {chapters.length > 4 && (
                        <li class="book-card__more">
                          <span>+ {chapters.length - 4} more</span>
                        </li>
                      )}
                    </ol>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── Standalone pieces ─────────────────────────────────── -->
  <section class="section section--tight" aria-labelledby="pieces-title">
    <div class="container">
      <h2 id="pieces-title" class="rule-label">
        Shorter pieces
      </h2>

      {
        pieces.length > 0 ? (
          <div class="pieces">
            {pieces.map((piece) => (
              <article class="piece">
                <a class="piece__link" href={`/writing/${piece.id}/`}>
                  <div class="piece__meta mono">
                    <span>{formLabels[piece.data.form] ?? 'Piece'}</span>
                    <span aria-hidden="true">/</span>
                    <time datetime={isoDate(piece.data.published)}>{formatMonth(piece.data.published)}</time>
                    <span aria-hidden="true">/</span>
                    <span>{readingTime(piece.body)} min</span>
                    {isDemo(piece) && <span class="chip">Sample</span>}
                  </div>
                  <h3 class="piece__title">{piece.data.title}</h3>
                  <p class="piece__desc">{piece.data.description}</p>
                  <span class="piece__more">
                    Read
                    <Icon name="arrow-right" size={13} />
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">
            <strong>No standalone pieces yet</strong>
            Add a Markdown file to <code>src/content/writing/</code> with
            <code>kind: piece</code>.
          </p>
        )
      }

      <p class="editor-hint">
        Everything here is Markdown in <code>src/content/writing/</code>. A standalone piece is one
        file with <code>kind: piece</code>. A book is one file with <code>kind: book</code> plus a
        folder of chapter files that reference it with <code>book: slug</code> and
        <code>chapter: 1</code>, <code>chapter: 2</code>…
      </p>
    </div>
  </section>

  <!-- ── Cross-link to blog ────────────────────────────────── -->
  <section class="cross-link">
    <div class="container cross-link__inner">
      <div>
        <p class="eyebrow">Elsewhere</p>
        <h2>Looking for the blog?</h2>
        <p>Notes on building software live on a separate shelf, so neither gets buried in the other.</p>
      </div>
      <a class="btn" href="/blog/">
        Read the blog
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Books ──────────────────────────────────────────────── */
  .shelf {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-md);
  }

  .book-card {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }

  /* A thin spine instead of a cover image: needs no asset, scales to any
     title, and reads instantly as "book". */
  .book-card__spine {
    position: relative;
    background:
      linear-gradient(180deg, var(--accent-soft), transparent 70%),
      var(--bg-sunken);
    border-inline-end: 1px solid var(--line);
    display: grid;
    place-items: center;
    padding-block: var(--space-md);
  }

  .book-card__spine-text {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-block-size: 100%;
  }

  .book-card__body {
    display: grid;
    gap: 0.6rem;
    padding: var(--space-md);
    align-content: start;
  }

  .book-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .book-card__title {
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .book-card__title a {
    text-decoration: none;
  }

  .book-card__title a:hover {
    color: var(--accent);
  }

  .book-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 56ch;
  }

  .book-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block-start: 0.3rem;
  }

  .book-card__foot .mono {
    font-size: 0.625rem;
    color: var(--ink-faint);
  }

  .book-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .book-card__link:hover {
    color: var(--accent);
  }

  .book-card__chapters {
    list-style: none;
    padding: 0.7rem 0 0;
    margin-block-start: 0.3rem;
    border-block-start: 1px dashed var(--line);
    display: grid;
    gap: 0.15rem;
  }

  .book-card__chapters a {
    display: flex;
    gap: 0.65rem;
    padding: 0.28rem 0;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .book-card__chapters a:hover {
    color: var(--accent);
  }

  .book-card__chapters .mono {
    font-size: 0.625rem;
    color: var(--ink-faint);
    padding-block-start: 0.25rem;
  }

  .book-card__more {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--ink-faint);
    padding-block-start: 0.25rem;
  }

  /* ── Pieces ─────────────────────────────────────────────── */
  .pieces {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    margin-block-start: var(--space-md);
  }

  .piece {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition:
      border-color var(--dur-mid) var(--ease-out),
      translate var(--dur-mid) var(--ease-out);
  }

  .piece:hover {
    border-color: var(--line-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .piece:hover {
      translate: 0 -2px;
    }
  }

  .piece__link {
    display: grid;
    gap: 0.5rem;
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
    block-size: 100%;
    align-content: start;
  }

  .piece__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .piece__title {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .piece:hover .piece__title {
    color: var(--accent);
  }

  .piece__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .piece__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  /* ── Cross link ─────────────────────────────────────────── */
  .cross-link {
    border-block-start: 1px solid var(--line);
    background: var(--bg-sunken);
  }

  .cross-link__inner {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-xl);
  }

  .cross-link h2 {
    font-size: var(--text-xl);
    margin-block: 0.5rem 0.4rem;
  }

  .cross-link p:not(.eyebrow) {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: 52ch;
  }

  @media (min-width: 48rem) {
    .book-card {
      grid-template-columns: 5rem 1fr;
    }

    .cross-link__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
